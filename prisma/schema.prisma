generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum InsightType {
  discovery
  decision
  solution
  issue
  caveat
}

enum RelationType {
  relates_to
  resolves
  supersedes
}

model Insight {
  id        Int         @id @default(autoincrement())
  type      InsightType
  content   String      @db.Text
  detail    String?     @db.MediumText
  rationale String?     @db.Text
  agent     String      @db.VarChar(50)
  repo      String?     @db.VarChar(200)
  branch    String?     @db.VarChar(200)
  sessionId String?     @map("session_id") @db.VarChar(100)
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tags              InsightTag[]
  followUps         FollowUp[]
  relationsAsSource InsightRelation[] @relation("source")
  relationsAsTarget InsightRelation[] @relation("target")

  @@index([agent])
  @@index([type])
  @@index([repo])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([repo, updatedAt])
  @@index([repo, type, updatedAt])
  @@fulltext([content])
  @@map("insights")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  insights InsightTag[]

  @@map("tags")
}

model InsightTag {
  insightId Int @map("insight_id")
  tagId     Int @map("tag_id")

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([insightId, tagId])
  @@map("insight_tags")
}

model FollowUp {
  id         Int       @id @default(autoincrement())
  insightId  Int       @map("insight_id")
  content    String    @db.Text
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  resolvedAt DateTime? @map("resolved_at")

  insight Insight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([insightId, resolved])
  @@map("follow_ups")
}

model InsightRelation {
  id       Int          @id @default(autoincrement())
  sourceId Int          @map("source_id")
  targetId Int          @map("target_id")
  type     RelationType

  source Insight @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target Insight @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([targetId])
  @@map("insight_relations")
}
